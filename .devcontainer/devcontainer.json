{
    "name": "gstreamer-pipeline",
    "image": "agrobotappliedai/deepstream-dev:latest",
    "workspaceFolder": "/workspaces/james",
    // "workspaceMount": "source=${localWorkspaceFolder},target=/james,type=bind",
    "workspaceMount": "source=/home/user/james,target=/james,type=bind",
    "runArgs": [
        "--privileged",
        "--network=host",
        "--runtime=nvidia",
        "--ipc=host",
        "--device=/dev/dri",
        "--device=/dev/nvmap",
        "--device=/dev/nvhost-ctrl-gpu",
        "--device=/dev/nvhost-prof-gpu",
        "--device=/dev/nvhost-gpu",
        "--device=/dev/nvhost-as-gpu"
    ],
    "mounts": [
        "source=/home/user/james,target=/workspaces/james,type=bind"
    ],
    "containerEnv": {
        "NVIDIA_VISIBLE_DEVICES": "all",
        "NVIDIA_DRIVER_CAPABILITIES": "compute,video,graphics,utility",
        "EGL_PLATFORM": "surfaceless",
        "GST_GL_PLATFORM": "egl",
        "GST_GL_WINDOW": "surfaceless",
        "DISPLAY": "",
        "WAYLAND_DISPLAY": "",
        "XAUTHORITY": "",
        "REMOTE_CONTAINERS_DISPLAY_SOCK": ""
    },
    "remoteEnv": {
        "DISPLAY": "",
        "WAYLAND_DISPLAY": "",
        "XAUTHORITY": "",
        "REMOTE_CONTAINERS_DISPLAY_SOCK": ""
    },
    "remoteUser": "root"
}